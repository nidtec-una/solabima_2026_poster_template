# LaTeX build artifacts (anywhere under latex/, including logos/
# where ad-hoc SVG->PDF conversions can leave stray logs)
latex/**/*.aux
latex/**/*.log
latex/**/*.out
latex/**/*.synctex.gz
latex/**/*.fls
latex/**/*.fdb_latexmk
latex/**/*.toc
latex/*.pdf

# Preview/export images
*.png
!latex/logos/*.png

# macOS
.DS_Store
